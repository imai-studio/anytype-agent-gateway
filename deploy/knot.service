# Reference unit only. Prefer:
#   knot service install --config ~/.config/knot/agent.yaml
# because it records the actual Node, compiled CLI, and config paths.
[Unit]
Description=Knot
After=network-online.target anytype.service
Wants=network-online.target anytype.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
Environment=PATH=%h/.local/bin:%h/.pnpm-global/bin:%h/.local/share/pnpm:%h/.local/share/pnpm/bin:%h/.local/share/mise/shims:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env knot run --config %h/.config/knot/agent.yaml
Restart=on-failure
RestartSec=5
# SIGTERM makes Knot stop streams, cancel active runs, close SQLite, and release
# its singleton lock. The timeout is a supervisor backstop.
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
