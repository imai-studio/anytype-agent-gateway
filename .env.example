# AAG configuration, identity IDs, wake authorization, and project declarations
# live in YAML, JSON, or TOML (you can create a safe baseline with `aag init`).
# Secrets stay outside the repository. This optional variable overrides the token
# read from the OpenClaw config file named by runtime.gateway.configFile.
OPENCLAW_GATEWAY_TOKEN=

# The Anytype API key is intentionally file-based. Set anytype.apiKeyFile in
# the AAG config to a mode-0600 file; do not put the key in this env file.
